{
    "name": "ftp-client",
    "version": "0.5.9",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "check": "tsc",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "validate": "pnpm audit --audit-level=high && pnpm run lint && pnpm run check && pnpm run format:check && pnpm run test run && echo 'Validation passed!'",
        "server:build": "cd server && node esbuild.config.js",
        "server:start": "cd server && node bundle.js",
        "server:build+start": "pnpm run server:build && pnpm run server:start"
    },
    "dependencies": {
        "@sayari/eslint-plugin": "0.0.1-rc.4",
        "@uiw/react-codemirror": "^4.25.12",
        "@zip.js/zip.js": "2.8.26",
        "basic-ftp": "^6.2.3",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.2",
        "eventemitter3": "^5.0.4",
        "jszip": "^3.10.2",
        "monaco-editor": "0.57.0",
        "monaco-editor-textmate": "^4.0.0",
        "monaco-textmate": "^3.0.1",
        "onigasm": "^2.2.5",
        "pako": "^2.2.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "ssh2-sftp-client": "^12.1.1",
        "ws": "^8.22.0",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/bootstrap": "^5.2.11",
        "@types/node": "^25.9.9",
        "@types/pako": "^2.0.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ssh2-sftp-client": "^9.0.6",
        "@types/wicg-file-system-access": "^2023.10.7",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/ui": "^5.0.5",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-path": "^3.0.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-unused-imports": "^4.4.1",
        "happy-dom": "^21.0.4",
        "prettier": "3.8.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
